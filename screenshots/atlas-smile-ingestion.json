    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  if (typeof item.json.pageContent === 'string') {\n    let cleaned = item.json.pageContent;\n    cleaned = cleaned.split('\\\\n').join(' ');\n    cleaned = cleaned.split('\\\\r').join(' ');\n    cleaned = cleaned.split('\\\\t').join(' ');\n    cleaned = cleaned.split('\\\\').join(' ');\n    cleaned = cleaned.replace(/[\\x00-\\x1F\\x7F]/g, ' ');\n    cleaned = cleaned.replace(/[\\uD800-\\uDFFF]/g, '');\n    // إزالة أحرف التحكم بالاتجاه (Bidi) وأحرف عرضها صفر\n    cleaned = cleaned.replace(/[\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u2069\\uFEFF]/g, '');\n    cleaned = cleaned.replace(/\\s{2,}/g, ' ').trim();\n    item.json.pageContent = cleaned;\n  }\n}\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        0
      ],
      "id": "657e10ec-5d76-4683-b96e-e27b5846a2a1",
      "name": "Code in JavaScript"
