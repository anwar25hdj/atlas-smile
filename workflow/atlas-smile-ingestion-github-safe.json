      "id": "a4a3c4b2-cc9b-4152-a2c4-c200412971c5",
      "name": "Code in JavaScript1"
    },
    {
      "parameters": {
        "jsCode": "\nfor (const item of $input.all()) {\n  if (item.json.pageContent) {\n    // توضيح صريح أن رقم 60,000 هو شرط تقسيط، مو سعر خدمة\n    item.json.pageContent = item.json.pageContent.replace(\n      /60,?000\\s*دج/g,\n      \"60,000 دج (هذا حد أدنى لتكلفة العلاج الذي يؤهل للتقسيط، وليس سعراً لأي خدمة بعينها)\"\n    );\n    // توضيح صريح أن رقم 6000 هو سعر أشعة، مو سعر زراعة\n    item.json.pageContent = item.json.pageContent.replace(\n      /6000\\s*دج/g,\n      \"6000 دج (سعر الأشعة ثلاثية الأبعاد فقط، وليس سعر عملية الزراعة نفسها)\"\n    );\n  }\n}\nreturn $input.all();"
      },
